# Autostart applications

# Load Xresources
exec --no-startup-id xrdb -merge ~/.Xresources

# Keyboard layout
exec --no-startup-id setxkbmap -layout us -variant intl

# Monitor layout
exec --no-startup-id ~/.screenlayout/3-monitors.sh

# Compositor (xcompmgr)
# exec_always --no-startup-id killall xcompmgr 2>/dev/null; xcompmgr -c -C -t-5 -l-5 -r4.2 -o.55 -f -F -D 5 -I 0.05 &
exec_always --no-startup-id pkill picom; picom --config ~/.config/picom/picom.conf

# Polybar
exec_always --no-startup-id $HOME/.config/polybar/start.sh

# System utilities
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id nitrogen --restore; sleep 1
exec --no-startup-id opendeck 
exec --no-startup-id nm-applet
exec --no-startup-id xfce4-power-manager
exec --no-startup-id clipit
exec --no-startup-id xautolock -time 10 -locker blurlock
exec_always --no-startup-id ff-theme-util
exec_always --no-startup-id fix_xcursor

# Volume icon
exec --no-startup-id volumeicon
