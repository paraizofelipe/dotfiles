# i3 config (v4)
# Please see http://i3wm.org/docs/userguide.html for a complete reference!
#
# This is a modular configuration file.
# Individual configuration sections are located in ~/.config/i3/config.d/
#
# Backup of original config: ~/.config/i3/config.backup

# Core variables (must be defined before includes)
set $mod Mod1

# Gruvbox color variables
set $bg #282828
set $red #cc241d
set $green #98971a
set $yellow #d79921
set $blue #458588
set $purple #b16286
set $aqua #689d68
set $gray #a89984
set $darkgray #1d2021
set $bg3 #665c54
set $bg4 #7c6f64
set $bg1 #3c3836
set $bg0_s #32302f

# Include modular configuration files in explicit order
include ~/.config/i3/config.d/general.i3config
include ~/.config/i3/config.d/keybindings.i3config
include ~/.config/i3/config.d/workspaces.i3config
include ~/.config/i3/config.d/theme.i3config
include ~/.config/i3/config.d/window-rules.i3config
include ~/.config/i3/config.d/autostart.i3config
include ~/.config/i3/config.d/modes.i3config
include ~/.config/i3/config.d/gaps.i3config
