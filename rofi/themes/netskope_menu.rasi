configuration {
	font:							"Hack Nerd Font 10";
    show-icons:                     false;
    display-drun: 					"";
    drun-display-format:            "{name}";
    disable-history:                false;
	sidebar-mode: 					false;
}

/* -- Gruvbox Theme -- */
* {
    background:                     #2f2f2fff;
    background-alt:              	#00000000;
    background-bar:                 #504945ff;
    foreground:                     #ebdbb2ff;
    accent:			            	#83a598ff;
}

window {
    transparency:                   "real";
    background-color:               @background;
    text-color:                     @foreground;
	border:							1px;
	border-color:					@accent;
    border-radius:                  4px;
	width:							280px;
    location:                       center;
    x-offset:                       0;
    y-offset:                       0;
}

prompt {
    enabled: 						true;
	padding: 						0.5% 1% 0% 0%;
	background-color: 				@background-alt;
	text-color: 					@accent;
	font:							"Hack Nerd Font 12";
}

entry {
    background-color:               @background-alt;
    text-color:                     @foreground;
    placeholder-color:              @foreground;
    expand:                         true;
    horizontal-align:               0;
    placeholder:                    "";
    padding:                        0.5% 0% 0% 0%;
    blink:                          true;
}

inputbar {
	children: 						[ prompt ];
    background-color:               @background;
    text-color:                     @foreground;
    expand:                         false;
	border:							0px;
    border-radius:                  0px;
	border-color:					@accent;
    margin:                         0% 0% 0% 0%;
    padding:                        1%;
}

listview {
    background-color:               @background-alt;
    columns:                        1;
    lines:                          7;
    spacing:                        0%;
    cycle:                          false;
    dynamic:                        true;
    layout:                         vertical;
}

mainbox {
    background-color:               @background-alt;
	border:							0%;
    border-radius:                  0%;
	border-color:					@accent;
    children:                       [ inputbar, listview ];
    spacing:                       	1%;
    padding:                        1%;
}

element {
    background-color:               @background-alt;
    text-color:                     @foreground;
    orientation:                    horizontal;
    border-radius:                  4px;
    padding:                        1% 1% 1% 1%;
}

element-text {
    background-color: 				@background-alt;
    text-color:       				inherit;
    expand:                         true;
    horizontal-align:               0;
    vertical-align:                 0.5;
    margin:                         0%;
    font:                           "Hack Nerd Font 11";
}

element selected {
    background-color:               @background-bar;
    text-color:                     @foreground;
	border:							0px;
    border-radius:                  4px;
    border-color:                  	@accent;
}
