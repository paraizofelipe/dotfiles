#!/usr/bin/env bash
# Shim de claude/codex: exporta a conta ativa (`agents account use`) e chama o CLI real.
# Um CLAUDE_CONFIG_DIR/CODEX_HOME já definido tem precedência sobre a conta ativa.
set -euo pipefail

name=$(basename "$0")
case "$name" in
  claude) var=CLAUDE_CONFIG_DIR ;;
  codex) var=CODEX_HOME ;;
  *) echo "agent-shim: invoque via symlink claude ou codex" >&2; exit 2 ;;
esac

pointer="${XDG_DATA_HOME:-$HOME/.local/share}/agents/active-$name"
if [[ -z "${!var:-}" && -r "$pointer" ]]; then
  home=$(<"$pointer")
  [[ -n "$home" && -d "$home" ]] && export "$var=$home"
fi

self=$(readlink -f "$0")
IFS=: read -ra path_dirs <<<"$PATH"
for dir in "${path_dirs[@]}"; do
  candidate="$dir/$name"
  [[ -x "$candidate" && ! -d "$candidate" ]] || continue
  [[ "$(readlink -f "$candidate")" == "$self" ]] && continue
  exec "$candidate" "$@"
done
echo "$name: binário real não encontrado no PATH" >&2
exit 127
